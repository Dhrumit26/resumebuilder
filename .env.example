# LLM Provider: "openai" or "grok"
LLM_PROVIDER=grok

# OpenAI (optional)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Grok (xAI)
GROK_API_KEY=xai-your-key-here
GROK_BASE_URL=https://api.x.ai/v1

# Two roles, two models. Writer does the section prose (quality matters most
# here); judge does JSON analysis/scoring where the strict rubric carries the
# work, so a fast non-reasoning model is enough.
GROK_MODEL=grok-4.5
GROK_WRITER_MODEL=grok-4.5
GROK_JUDGE_MODEL=grok-4.20-0309-non-reasoning

# Writer quality/cost options:
#   grok-4.20-non-reasoning  -> fastest / cheapest
#   grok-4.3                 -> better quality, more cost
#   grok-4.5                 -> best quality, slowest/most expensive (default)

# Comma-separated companies whose experience bullets may be re-angled to the JD's
# domain and may name JD tools absent from the original resume. Intended for the
# CURRENT role only — every other job stays under the strict truthfulness gate.
FLEXIBLE_EXPERIENCE_COMPANIES=Clerxi AI

# Specialized JD tools (Microsoft Fabric, Snowflake, …) are looked up on the web
# via Microsoft Learn / Wikipedia before writing — no extra API key required.

# Fix loop
SCORE_THRESHOLD=90
# TARGET_SCORE is the early-exit target. Keep it at 92: the reviewer rubric caps
# differentiation at 2/5 and keyword_optimization at 5/10 when its anti-AI penalty
# fires, so 92 is the reachable ceiling. A higher value makes the exit condition
# unsatisfiable and every build grinds through all MAX_REMAKE_ATTEMPTS for nothing.
TARGET_SCORE=92
MAX_REMAKE_ATTEMPTS=4

# Quality knobs. Section agents run fully in parallel and candidates are scored
# concurrently, so these cost tokens rather than much wall-clock. Lowering them is
# the wrong way to speed up a build — SCORE_SAMPLES=1 in particular makes scoring
# noisy enough to pick the wrong candidate and chase bogus fixes.
BEST_OF_N=2
SCORE_SAMPLES=2

# Reasoning models are slow; keep this well above your worst-case section call.
LLM_TIMEOUT_SECONDS=300
