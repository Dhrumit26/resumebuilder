# LLM Provider: "openai" or "grok"
LLM_PROVIDER=grok

# OpenAI (optional)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Grok (xAI) — use non-reasoning for speed/cost on resume rewriting
GROK_API_KEY=xai-your-key-here
GROK_MODEL=grok-4.20-non-reasoning
GROK_BASE_URL=https://api.x.ai/v1

# Quality/cost options:
#   grok-4.20-non-reasoning  -> fastest / cheapest (recommended)
#   grok-4.3                 -> better quality, more cost
#   grok-4.5                 -> best quality, slowest/most expensive

# Remake loop
SCORE_THRESHOLD=80
MAX_REMAKE_ATTEMPTS=2
